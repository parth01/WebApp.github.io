{
  "name": "medicine-details-desktop",
  "version": "1.0.0",
  "description": "Windows desktop Medicine Details Manager with local C:\\medicine data storage and admin view",
  "main": "electron/main.js",
  "author": "parth01",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.parth01.medicinedetails",
    "productName": "Medicine Details Manager",
    "files": [
      "index.html",
      "app.js",
      "electron/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
